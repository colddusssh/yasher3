%YAML 1.2
---
name: Русь
file_extensions: [русь, рус, yascher, ящ, змей, ящер]
scope: source.русь

contexts:
  main:
    # Ключевые слова (управляющие конструкции)
    - match: \b(прерыв|бить_ящеров|обряд|коли|отнюдь|отнюдь_если|покуда|для|воздать|династия|попытаться|поймать|поднять|с_чем|внедрить|из|как|не|и|или|в|есть|ламбда|уступить|глобал|нелокальный|утверждать|перерыв|продолжить|проход|удалить|переключатель|путь|базированно)\b
      scope: keyword.control.русь

    # Логические константы
    - match: \b(правда|кривда|никто|ничто)\b
      scope: constant.language.русь

    # Встроенные функции
    - match: \b(в_строченьку|молвить|внемлить|длина|диапазон|тип|строка|целина|дробь|комплекс|список|кортеж|словарь|множество|булево|байты|байтовый_массив|открыть|прочитать|писать|закрыть|мощь|помощь|выйти|перечисление|сцепление|отобразить|отфильтровать|сортированный|обратный|минимум|максимум|сумма|абсолют|округлить)\b
      scope: support.function.русь

    # Методы работы с коллекциями
    - match: \b(приклеить|растянуть|вставить|убрать|очистить|счёт|индекс|скопировать|обновить|ключи|значения|предметы|получить)\b
      scope: support.method.русь

    # Имена модулей
    - match: \b(Русь|времечко|случайно|математика|регулярка|ос|json|пикль|датавремя|коллекции|итератул)\b
      scope: support.module.русь

    # Исключения
    - match: \b(беда|ошибка_значения|ошибка_типа|ошибка_индекса|ошибка_ключа|ошибка_имени|ошибка_атрибута|ошибка_импорта|ошибка_останова)\b
      scope: support.type.exception.русь

    # Специальные методы ООП
    - match: \b(сам|местный|инициализация|строка_документации|родитель)\b
      scope: variable.language.русь

    # Числа
    - match: \b\d+\b
      scope: constant.numeric.русь

    # Строки в двойных кавычках
    - match: '"'
      push: string_double

    # Строки в одинарных кавычках
    - match: "'"
      push: string_single

    # Комментарии (начинаются с #)
    - match: '#.*$'
      scope: comment.line.русь

  # Контекст для строк в двойных кавычках
  string_double:
    - meta_scope: string.quoted.double.русь
    - match: '\\.'
      scope: constant.character.escape.русь
    - match: '"'
      pop: true

  # Контекст для строк в одинарных кавычках
  string_single:
    - meta_scope: string.quoted.single.русь
    - match: '\\.'
      scope: constant.character.escape.русь
    - match: "'"
      pop: true